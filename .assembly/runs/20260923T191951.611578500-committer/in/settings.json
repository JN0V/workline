{
  "body-max-lines": 12,
  "internal-codes": [
    "\\b[A-Z]{1,4}(-NEW)?-[0-9]+\\b"
  ],
  "internal-codes-allow": [
    "UTF-8",
    "UTF-16",
    "SHA-1",
    "SHA-256",
    "SHA-512",
    "ISO-8601",
    "RFC-[0-9]+",
    "CVE-[0-9]+"
  ],
  "subject-max": 72,
  "types": [
    "feat",
    "fix",
    "docs",
    "test",
    "refactor",
    "perf",
    "build",
    "ci",
    "chore",
    "revert"
  ]
}