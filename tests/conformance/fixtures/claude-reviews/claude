#!/bin/sh
# A stand-in for `claude -p` as the reviewer's lenses run it with read-only
# tools (docs/adr/0074). It fails, saying why, unless given Read, Glob and Grep
# alone, none allowed by name, its turns capped, its prompt the role's, and
# run in a copy of the repository at the change's head; its question must
# say it reads the repository itself and hold the change as a diff, or
# name the file of its folder holding it, not the code the change calls. Then it reads calc/calc.go, which the change
# does not touch, and answers a finding there, in stream-json.
set -eu
want() { echo "claude stand-in: $*" >&2; exit 1; }
args=" " skip=
for a in "$@"; do
	[ -z "$skip" ] || skip=
	args="$args$a "
	case "$a" in --system-prompt-file) skip=1 ;; esac
done
for a in "--output-format stream-json" "--verbose" "--tools Read,Glob,Grep" \
	"--permission-mode dontAsk" "--strict-mcp-config" \
	"--setting-sources user" "--no-session-persistence" "--system-prompt-file" "--max-turns 40"; do
	case "$args" in *" $a "*) ;; *) want "not given $a" ;; esac
done
case "$args" in *Bash* | *Edit* | *Write* | *" --allowedTools "*) want "given more than reading in its folder: $*" ;; esac
[ "$(git rev-parse --show-toplevel)" = "$(pwd -P)" ] && [ -f calc/half.go ] && [ -f calc/calc.go ] || want "not run in a copy of the repository at the head: $(pwd)"
question=$(cat)
for w in '## Reading the repository yourself' 'Read, Glob and Grep' '40 turns at most'; do
	case "$question" in *"$w"*) ;; *) want "the question does not say $w" ;; esac
done
# The change in its question, or, too long, in the file it names.
change=$question
case "$question" in *workline-change.diff*)
	change=$(cat workline-change.diff) || want "no workline-change.diff in its folder"
	printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t0","name":"Read","input":{"file_path":"%s/workline-change.diff"}}]}}\n' "$(pwd -P)"
	;;
esac
case "$change" in *'+++ b/calc/half.go'*) ;; *) want "not given the change" ;; esac
case "$question" in *strconv.Atoi*) want "the question gives code the change does not touch" ;; esac
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"%s/calc/calc.go"}}]}}\n' "$(pwd -P)"
cat <<'R'
{"type":"result","subtype":"success","is_error":false,"num_turns":2,"result":"- finding:\n    lens: correctness\n    severity: important\n    title: Half of a word that is no number is zero\n    why: Parse drops the error Atoi returns, so Half reads any word as 0\n    cause: {path: calc/calc.go, quote: \"n, _ := strconv.Atoi(s)\"}\n    symptom: {path: calc/half.go, quote: \"return Parse(s) / 2\"}\n    fix: return the error from Parse\n","total_cost_usd":0.02,"modelUsage":{"claude-sonnet-5":{"inputTokens":1500,"cacheReadInputTokens":9000,"cacheCreationInputTokens":500,"outputTokens":300}}}
R
