#!/bin/sh
# A stand-in for `claude -p` as the documentalist runs it with read-only
# tools (docs/adr/0074). It fails, saying why, unless given Read, Glob and
# Grep alone, none allowed by name, its turns capped, and run in a copy of
# the repository at HEAD; its question must say it reads the repository
# itself and name the doc's source, never give it. Then it reads
# src/auth/token.go — or nothing, with READS=none — and answers the fix
# doc-fixed answers, moving `checked`, in stream-json.
set -eu
want() { echo "claude stand-in: $*" >&2; exit 1; }
args=" " skip=
for a in "$@"; do
	[ -z "$skip" ] || skip=
	args="$args$a "
	case "$a" in --system-prompt-file) skip=1 ;; esac
done
for a in "--output-format stream-json" "--verbose" "--tools Read,Glob,Grep" \
	"--permission-mode dontAsk" "--strict-mcp-config" \
	"--setting-sources user" "--no-session-persistence" "--system-prompt-file" "--max-turns 40"; do
	case "$args" in *" $a "*) ;; *) want "not given $a" ;; esac
done
case "$args" in *Bash* | *Edit* | *Write* | *" --allowedTools "*) want "given more than reading in its folder: $*" ;; esac
[ "$(git rev-parse --show-toplevel)" = "$(pwd -P)" ] && grep -q 7200 src/auth/token.go || want "not run in a copy of the repository at HEAD: $(pwd)"
question=$(cat)
for w in '## Reading the repository yourself' 'Read, Glob and Grep' '40 turns at most' '- `src/auth/token.go`'; do
	case "$question" in *"$w"*) ;; *) want "the question does not say $w" ;; esac
done
case "$question" in *'const TokenTTL'*) want "the question gives the source it should read" ;; esac
if [ "${READS:-}" != none ]; then
	printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"%s/src/auth/token.go"}}]}}\n' "$(pwd -P)"
fi
cat <<'R'
{"type":"result","subtype":"success","is_error":false,"num_turns":2,"result":"- patch: |\n    --- a/docs/tech/auth.md\n    +++ b/docs/tech/auth.md\n    @@ -3,3 +3,4 @@ type: reference\n     sources: [src/auth/token.go]\n    -checked: 9bf650b\n    +checked: 1a8e5a4\n    +verified: agent:documentalist\n     ---\n    @@ -9,2 +10,2 @@ checked: 9bf650b\n     \n    -Access tokens last one hour.\n    +Access tokens last two hours.\n- claim:\n    doc: docs/tech/auth.md\n    lines: \"10\"\n    status: contradicted\n    source: {path: src/auth/token.go, quote: \"const TokenTTL = 7200\"}\n","total_cost_usd":0.02,"modelUsage":{"claude-sonnet-5":{"inputTokens":1500,"cacheReadInputTokens":9000,"cacheCreationInputTokens":500,"outputTokens":300}}}
R
