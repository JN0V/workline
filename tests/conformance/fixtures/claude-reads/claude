#!/bin/sh
# A stand-in for `claude -p` as the tester runs it with read-only tools
# (ADR-0063 §8). It fails, saying why, unless given Read, Glob and Grep
# alone, none allowed by name (dontAsk then keeps them in its folder),
# its prompt the role's, its turns capped, and run
# in a copy of the repository at its base, with no shell; its question
# must say it reads the code itself. Then it reads lib.sh, searches, and
# answers two tests, one per scenario, and a note of what they assume,
# in stream-json. The role's shared part, its instruction and answer's
# shape, is its system prompt, the same each call; the task alone is on
# stdin (#1128).
set -eu
want() { echo "claude stand-in: $*" >&2; exit 1; }
# Its flags; the system prompt in the file its flag names, never on
# the command line, too long for Windows (#1128).
args=" " skip= system=
for a in "$@"; do
	[ -z "$skip" ] || { skip=; system=$(cat "$a"); }
	args="$args$a "
	case "$a" in --system-prompt-file | --append-system-prompt-file) skip=1 ;; esac
done
for a in "--output-format stream-json" "--verbose" "--tools Read,Glob,Grep" \
	"--permission-mode dontAsk" "--strict-mcp-config" \
	"--setting-sources user" "--no-session-persistence" "--system-prompt-file" "--max-turns 40"; do
	case "$args" in *" $a "*) ;; *) want "not given $a" ;; esac
done
case "$args" in *Bash* | *Edit* | *Write* | *" --allowedTools "* | *" --append-system-prompt"*) want "given more than reading in its folder: $*" ;; esac
[ "$(git rev-parse --show-toplevel)" = "$(pwd -P)" ] && [ -f lib.sh ] || want "not run in a copy of the repository: $(pwd)"
grep -q 'add()' lib.sh && ! grep -q 'mul()' lib.sh || want "not the base's code"
question=$(cat)
for w in 'You write the acceptance tests of one issue' '# Answer'; do
	case "$system" in *"$w"*) ;; *) want "the system prompt does not hold $w" ;; esac
done
case "$question" in '# Task'*) ;; *) want "the question does not start with its task" ;; esac
case "$question" in *'You write the acceptance tests of one issue'* | *'# Answer'*) want "the question repeats the shared part" ;; esac
case "$args" in *" --system-prompt "*) want "its system prompt on the command line" ;; esac
for w in '## Reading the code yourself' 'Read, Glob and Grep' '40 turns at most'; do
	case "$question" in *"$w"*) ;; *) want "the question does not say $w" ;; esac
done
tool() { printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t%s","name":"%s","input":{%s}}]}}\n' "$1" "$2" "$3"; }
echo '{"type":"system","subtype":"init","tools":["Read","Glob","Grep"]}'
tool 1 Glob '"pattern":"tests/**"'
tool 2 Grep '"pattern":"add"'
tool 3 Read "\"file_path\":\"$(pwd -P)/lib.sh\""
cat <<'R'
{"type":"result","subtype":"success","is_error":false,"num_turns":4,"result":"- patch:\n    file: tests/test_mul_two_by_three.sh\n    content: |\n      # Scenario: Two by three\n      # Given the library, When I multiply 2 by 3, Then I get 6.\n      . ./lib.sh\n      [ \"$(mul 2 3)\" = 6 ]\n- patch:\n    file: tests/test_mul_by_zero.sh\n    content: |\n      # Scenario: By zero\n      # Given the library, When I multiply 5 by 0, Then I get 0.\n      . ./lib.sh\n      [ \"$(mul 5 0)\" = 0 ]\n- note: \"assumes: mul takes its two numbers as arguments, as add does\"\n- covers: {scenario: Two by three, tests: [test_mul_two_by_three]}\n- covers: {scenario: By zero, tests: [test_mul_by_zero]}\n","total_cost_usd":0.03,"modelUsage":{"claude-sonnet-5":{"inputTokens":2000,"cacheReadInputTokens":20000,"cacheCreationInputTokens":1000,"outputTokens":800}}}
R
