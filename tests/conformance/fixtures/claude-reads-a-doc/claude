#!/bin/sh
# A stand-in for `claude -p` as the documentalist runs it on a doc too
# long to be shown in its task: Read, Glob and Grep alone, in a copy of
# the repository at HEAD. It fails, saying why, unless its question names
# docs/tech/auth.md to be read there and holds none of the doc's own
# lines. Then it reads the doc, and answers its fix: two hours, `judged`
# set at HEAD, `checked` left as it is, the sentence's claim cited.
set -eu
want() { echo "claude stand-in: $*" >&2; exit 1; }
args=" $* "
for a in "--output-format stream-json" "--tools Read,Glob,Grep" "--permission-mode dontAsk"; do
	case "$args" in *" $a "*) ;; *) want "not given $a" ;; esac
done
case "$args" in *Bash* | *Edit* | *Write* | *" --allowedTools "*) want "given more than reading: $*" ;; esac
[ "$(git rev-parse --show-toplevel)" = "$(pwd -P)" ] && [ -f docs/tech/auth.md ] || want "not run in a copy of the repository: $(pwd)"
grep -q 7200 src/auth/token.go || want "not the code at HEAD"
question=$(cat)
case "$question" in *'read `docs/tech/auth.md` whole in your working directory'*) ;; *) want "the question does not say to read the doc" ;; esac
case "$question" in *'token number'*) want "the question holds the doc's text" ;; esac
new=$(mktemp)
sed "s/^checked: .*/&\njudged: $(git rev-parse --short HEAD)/; s/Access tokens last one hour./Access tokens last two hours./" docs/tech/auth.md > "$new"
patch=$(diff -u --label a/docs/tech/auth.md --label b/docs/tech/auth.md docs/tech/auth.md "$new" | sed 's/^/    /' || true)
rm -f "$new"
answer=$(printf -- '- patch: |\n%s\n- claim:\n    doc: docs/tech/auth.md\n    lines: "10"\n    status: contradicted\n    source: {path: src/auth/token.go, quote: "const TokenTTL = 7200"}\n' "$patch")
json=$(printf '%s' "$answer" | awk 'BEGIN{ORS=""} {gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/,"\\t"); print $0 "\\n"}')
echo '{"type":"system","subtype":"init","tools":["Read","Glob","Grep"]}'
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"%s/docs/tech/auth.md"}}]}}\n' "$(pwd -P)"
printf '{"type":"result","subtype":"success","is_error":false,"num_turns":2,"result":"%s","total_cost_usd":0.01,"modelUsage":{"claude-sonnet-5":{"inputTokens":2000,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"outputTokens":300}}}\n' "$json"
