#!/bin/sh
# A stand-in for `claude -p` as the documentalist runs it on a doc judged in
# parts (`documented`, its doc naming src/auth/big.go too, tokens gone to two
# hours): Read, Glob and Grep alone, in a copy of the repository at HEAD,
# which each part and the fix that follows say to read, as a doc judged
# whole does. It fails, saying why, otherwise. The part holding token.go
# answers line 10 contradicted, the other nothing; the fix patches the
# sentence, the header left alone, citing the code.
set -eu
want() { echo "claude stand-in: $*" >&2; exit 1; }
args=" $* "
for a in "--output-format stream-json" "--tools Read,Glob,Grep" "--permission-mode dontAsk"; do
	case "$args" in *" $a "*) ;; *) want "not given $a" ;; esac
done
case "$args" in *Bash* | *Edit* | *Write* | *" --allowedTools "*) want "given more than reading: $*" ;; esac
[ "$(git rev-parse --show-toplevel)" = "$(pwd -P)" ] && [ -f docs/tech/auth.md ] || want "not run in a copy of the repository: $(pwd)"
grep -q 7200 src/auth/token.go || want "not the code at HEAD"
question=$(cat)
case "$question" in *'You read the project yourself, in your working directory, a checkout of the commit judged'*) ;; *) want "the question does not give the repository to read" ;; esac
case "$question" in
*'Kind: part'*'const TokenTTL = 7200'*)
	answer=$(printf -- '- claim:\n    lines: "10"\n    status: contradicted\n    quote: "Access tokens last one hour."\n    source: {path: src/auth/token.go, lines: "4", quote: "const TokenTTL = 7200"}\n    why: "7200 seconds is two hours"\n') ;;
*'Kind: part'*) answer='[]' ;;
*'Kind: fix'*)
	new=$(mktemp)
	sed "s/Access tokens last one hour./Access tokens last two hours./" docs/tech/auth.md > "$new"
	patch=$(diff -u --label a/docs/tech/auth.md --label b/docs/tech/auth.md docs/tech/auth.md "$new" | sed 's/^/    /' || true)
	rm -f "$new"
	answer=$(printf -- '- patch: |\n%s\n- claim:\n    doc: docs/tech/auth.md\n    lines: "10"\n    status: contradicted\n    source: {path: src/auth/token.go, quote: "const TokenTTL = 7200"}\n' "$patch") ;;
*) want "neither a part nor the fix" ;;
esac
json=$(printf '%s' "$answer" | awk 'BEGIN{ORS=""} {gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/,"\\t"); print $0 "\\n"}')
echo '{"type":"system","subtype":"init","tools":["Read","Glob","Grep"]}'
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"%s/src/auth/token.go"}}]}}\n' "$(pwd -P)"
printf '{"type":"result","subtype":"success","is_error":false,"num_turns":2,"result":"%s","total_cost_usd":0.01,"modelUsage":{"claude-sonnet-5":{"inputTokens":2000,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"outputTokens":300}}}\n' "$json"
